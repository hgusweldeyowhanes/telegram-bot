# ── Telegram ──────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Channel username (e.g. @mytechchannel) or numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_here

# ── News API ──────────────────────────────
# Free key from https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Schedule ──────────────────────────────
# Time to post daily news (UTC)
POST_HOUR=9
POST_MINUTE=0

# Default topic for the daily job and /news
# One of: tech, ai, cyber, startups, cloud, gadgets
DEFAULT_TOPIC=tech

# How many articles to post
ARTICLE_COUNT=5

# 1 = one briefing message, 0 = one Telegram message per article
DIGEST_MODE=1

# ── Access control ────────────────────────
# Comma-separated Telegram user IDs allowed to run /news and topic commands.
# Leave empty to allow anyone who can message the bot.
ADMIN_IDS=

# ── Deduplication ─────────────────────────
# JSON file of already-posted article fingerprints
DEDUPE_PATH=data/posted_urls.json

# ── AI summaries (optional) ───────────────
# When set, each story gets a one-line OpenAI summary instead of the raw blurb.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to 0 to force description-only even if a key is present
AI_SUMMARY=1

# ── Testing ───────────────────────────────
# Set > 0 to post repeatedly every N minutes (for testing), starting 10s
# after launch. Set back to 0 for normal once-daily posting.
TEST_INTERVAL_MINUTES=0

# ── Render / webhook ──────────────────────
# Auto-enabled when RENDER_EXTERNAL_URL is present.
# Set to 1 to force webhook locally behind a tunnel; 0 to force polling.
USE_WEBHOOK=0
# Public HTTPS base URL (Render injects RENDER_EXTERNAL_URL for you)
WEBHOOK_URL=
WEBHOOK_PATH=telegram
# PORT is set automatically by Render
# PORT=8080
