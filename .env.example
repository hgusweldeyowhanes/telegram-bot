# ── Telegram ──────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Channel username (e.g. @mytechchannel) or numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_here

# ── News API ──────────────────────────────
# Free key from https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Schedule ──────────────────────────────
# Time to post daily news (UTC)
POST_HOUR=9
POST_MINUTE=0

# ── Testing ───────────────────────────────
# Set > 0 to post repeatedly every N minutes (for testing), starting 10s
# after launch. Set back to 0 for normal once-daily posting.
TEST_INTERVAL_MINUTES=0
